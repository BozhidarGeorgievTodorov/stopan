#!/bin/sh
set -e

if ! getent group stopan >/dev/null; then
    addgroup --system stopan >/dev/null
fi

if ! getent passwd stopan >/dev/null; then
    adduser \
        --system \
        --ingroup stopan \
        --home /var/lib/stopan \
        --no-create-home \
        --disabled-login \
        --gecos "Stopan service user" \
        stopan >/dev/null
fi

install -d -o root -g stopan -m 0750 /etc/stopan
install -d -o root -g stopan -m 0750 /etc/stopan/jobs
install -d -o root -g stopan -m 0750 /etc/stopan/profiles
install -d -o stopan -g stopan -m 0750 /var/lib/stopan
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/state
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/data
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/data/chunks
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/metadata
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/metadata/object_store
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/metadata/packs
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/metadata/packs/generated
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/metadata/packs/recovered
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/custody
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/custody/chunks
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/custody/ec_shards
install -d -o stopan -g stopan -m 0750 /var/lib/stopan/custody/metadata_packs
install -d -o stopan -g stopan -m 0750 /var/log/stopan

install_if_missing() {
    src="$1"
    dst="$2"
    mode="$3"
    owner="$4"
    group="$5"

    if [ -f "$src" ] && [ ! -e "$dst" ]; then
        install -o "$owner" -g "$group" -m "$mode" "$src" "$dst"
    fi
}

install_if_missing \
    "/usr/share/doc/stopan/examples/configs/stopan.yaml" \
    "/etc/stopan/stopan.yaml" \
    0640 \
    root \
    stopan

# Los perfiles de jobs no se copian automáticamente a /etc/stopan/jobs.
# El sysadmin puede copiarlos desde /usr/share/doc/stopan/examples/jobs/ y
# crear tantas instancias como necesite: stopan-job@nombre.service/timer.

#DEBHELPER#
