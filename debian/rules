#!/usr/bin/make -f

export PIP_DISABLE_PIP_VERSION_CHECK=1

%:
	dh $@

override_dh_auto_clean:
	rm -rf build .pybuild .build-venv *.egg-info src/*.egg-info src/stopan.egg-info debian/stopan/opt/stopan/venv
	rm -f src/stopan/protos/*_pb2.py src/stopan/protos/*_pb2_grpc.py

override_dh_auto_configure:
	# Stopan se empaqueta como aplicación autocontenida en /opt/stopan.
	# No usamos la configuración automática Python/distutils de debhelper.

override_dh_auto_build:
	python3 -m venv .build-venv
	.build-venv/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel
	.build-venv/bin/python -m pip install --no-cache-dir -r requirements-build.txt
	.build-venv/bin/python -m grpc_tools.protoc \
		-Isrc \
		--python_out=src \
		--grpc_python_out=src \
		src/stopan/protos/p2p_storage.proto \
		src/stopan/protos/membership.proto

override_dh_auto_install:
	python3 -m venv debian/stopan/opt/stopan/venv
	debian/stopan/opt/stopan/venv/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel
	debian/stopan/opt/stopan/venv/bin/python -m pip install --no-cache-dir -r requirements.txt .
	find debian/stopan/opt/stopan/venv -type d -name __pycache__ -prune -exec rm -rf {} +
	find debian/stopan/opt/stopan/venv -type f -name '*.pyc' -delete

override_dh_auto_test:
	# Los tests de integración se ejecutarán desde GitHub Actions.
	# Evitamos unittest discover implícito durante la construcción del .deb.

override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
