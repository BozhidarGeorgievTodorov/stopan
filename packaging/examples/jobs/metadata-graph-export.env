# Perfil de ejemplo: exportar la DB local al metadata object graph.
STOPAN_JOB_KIND=metadata-graph
STOPAN_METADATA_GRAPH_ACTION=export
STOPAN_METADATA_PACK=true
# STOPAN_METADATA_OBJECT_STORE=/var/lib/stopan/metadata_object_store
# STOPAN_METADATA_PACK_DIR=/var/lib/stopan/metadata_packs
STOPAN_METADATA_PASSPHRASE_FILE=/etc/stopan/metadata.passphrase
