# Perfil de ejemplo: reconstruir _metadata.db desde el latest del object graph.
STOPAN_JOB_KIND=metadata-graph
STOPAN_METADATA_GRAPH_ACTION=import
# STOPAN_METADATA_OBJECT_STORE=/var/lib/stopan/metadata_object_store
STOPAN_METADATA_PASSPHRASE_FILE=/etc/stopan/metadata.passphrase
# STOPAN_METADATA_NO_PROTECTION=false
