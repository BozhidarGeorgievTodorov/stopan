# Perfil de ejemplo: distribuir metadata pack a otros nodos.
# Si STOPAN_METADATA_PACK_IN se omite, Stopan crea el pack desde el latest object graph.
STOPAN_JOB_KIND=metadata-pack
STOPAN_METADATA_PACK_ACTION=push
STOPAN_METADATA_PASSPHRASE_FILE=/etc/stopan/metadata.passphrase
# STOPAN_METADATA_PACK_IN=/var/lib/stopan/metadata_packs/pack.stopanmetapack
# STOPAN_PACK_COPIES=3
# STOPAN_STRICT_PACK_COPIES=false
