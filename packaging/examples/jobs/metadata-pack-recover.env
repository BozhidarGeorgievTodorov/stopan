# Perfil de ejemplo: recuperar metadata desde packs remotos distribuidos.
STOPAN_JOB_KIND=metadata-pack
STOPAN_METADATA_PACK_ACTION=recover
STOPAN_METADATA_PASSPHRASE_FILE=/etc/stopan/metadata.passphrase
