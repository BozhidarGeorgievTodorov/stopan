[Unit]
Description=Stopan scheduled job profile: %i
Documentation=file:/usr/share/doc/stopan/local-network-deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=stopan
Group=stopan
WorkingDirectory=/var/lib/stopan
RuntimeDirectory=stopan
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=stopan
StateDirectoryMode=0750
LogsDirectory=stopan
LogsDirectoryMode=0750
ExecStart=/usr/bin/flock -n /run/stopan/%i.lock /usr/lib/stopan/jobs/run-job %i
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/stopan /var/lib/stopan /var/log/stopan /run/stopan
