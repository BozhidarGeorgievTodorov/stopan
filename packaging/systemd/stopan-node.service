[Unit]
Description=Stopan storage and membership node
Documentation=file:/usr/share/doc/stopan/jobs.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stopan
Group=stopan
WorkingDirectory=/var/lib/stopan
ExecStart=/usr/bin/stopan node
Restart=on-failure
RestartSec=5s
# La parada ordenada drena operaciones ya admitidas antes de terminar el daemon.
TimeoutStopSec=infinity
RuntimeDirectory=stopan
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=stopan
StateDirectoryMode=0750
LogsDirectory=stopan
LogsDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/stopan /var/lib/stopan /var/log/stopan /run/stopan

[Install]
WantedBy=multi-user.target
